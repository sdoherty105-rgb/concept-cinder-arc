{
  "name": "concept-cinder-arc",
  "version": "0.1.0",
  "private": true,
  "description": "Cinder Arc: an OFF/SHIFT concept website (fictional demonstration).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "render:stills": "node scripts/render-stills.mjs",
    "screens": "node scripts/screens.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:smoke": "node scripts/wrangler-smoke.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "1.64.1",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
